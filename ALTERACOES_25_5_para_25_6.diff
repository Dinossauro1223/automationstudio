+                     sair=lambda codigo: (saidas.append(codigo), avisado.set()), ambiente="a", alarme_nativo=False).iniciar()
+    try:
+        relogio.advance(31.0)
+        assert avisado.wait(10.0), "o vigia não disparou depois do limite"
+    finally:
