     """Golden que nenhum cenário cita (o nome entre aspas) no código-fonte dos cenários."""
     return [nome for nome in nomes if f'"{nome}"' not in fontes_dos_cenarios]
diff -ruN '--exclude=__pycache__' '--exclude=logs' '--exclude=.pytest_cache' AS_25_5/tests/unit/test_diagnostico_qt.py AS_25_6/tests/unit/test_diagnostico_qt.py
